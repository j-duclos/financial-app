# Backend — copy to budget-app/backend/.env for local dev (not committed).
#
# Database (pick one):
# A) Render external Postgres (local dev against production data) — copy from Render Dashboard
#    → Connections → External, include ?sslmode=require. Also save in backend/.env.render for sync scripts.
# DATABASE_URL=postgresql://user:pass@dpg-xxx.oregon-postgres.render.com/dbname?sslmode=require
#
# B) Local Docker Postgres (fast, isolated) — docker compose up -d postgres, then:
# DATABASE_URL=postgres://budget:budget@localhost:5433/budget
#
# C) SQLite — comment out DATABASE_URL entirely (backend/db.sqlite3).
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
# Render production: [PERF] logs default ON when RENDER=true. Set ENABLE_PERF_LOGS=false to disable.
# ENABLE_PERF_LOGS=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (Render): comma-separated https origins (no trailing slash)
# ALLOWED_HOSTS=budget-app-api.onrender.com,.onrender.com
# CSRF_TRUSTED_ORIGINS=https://budget-app-api.onrender.com,https://budget-app-web.onrender.com
# CORS_ALLOWED_ORIGINS=https://budget-app-web.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAGE_SIZE=20

# Redis — timeline + dashboard cache (required for fast repeat loads on Render).
# Local: docker compose up -d redis  then:
REDIS_URL=redis://localhost:6379/0
# Render: Dashboard → Key Value → copy Internal Redis URL to web service REDIS_URL.

# Plaid — keys from https://dashboard.plaid.com/team/keys
# Load these into budget-app/backend/.env (used when you run Django locally).
# Same variables work in Docker if you pass them (see docker-compose.yml / root .env).
#
# PLAID_CLIENT_ID is one ID for all environments (shown once on the Keys page).
#
# IMPORTANT — two different ideas people mix up:
# (1) Dashboard "Sandbox" vs "Production" SECRET are different passwords Plaid gives you.
# (2) PLAID_ENV tells THIS APP which Plaid API server to call (sandbox.plaid.com vs production.plaid.com).
#     While PLAID_ENV=sandbox, your requests NEVER touch live banks — even if you pasted the Production
#     secret (that usually yields INVALID_API_KEYS because secret must match the server).
# To link REAL institutions: set PLAID_ENV=production, put the Production secret in PLAID_SECRET or
# PLAID_PRODUCTION_SECRET, restart Django — and your Plaid account must have Production access enabled.
#
# Secrets must match PLAID_ENV / API host. Optional explicit vars avoid swapping PLAID_SECRET:
# PLAID_SANDBOX_SECRET, PLAID_DEVELOPMENT_SECRET, PLAID_PRODUCTION_SECRET (each falls back to PLAID_SECRET).
# If Plaid returns INVALID_API_KEYS, client_id + secret don't match that environment's Keys row.
# Paste from Plaid Team → Keys (Production row). Real values go in backend/.env only — never commit secrets here.
PLAID_CLIENT_ID=
PLAID_ENV=production
PLAID_PRODUCTION_SECRET=
# Fake institutions only (do not use with real banks):
# PLAID_ENV=sandbox
# PLAID_SANDBOX_SECRET=
# PLAID_SECRET=
# Optional: Fernet key from `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# If unset, tokens are encrypted using a key derived from DJANGO_SECRET_KEY (rotate secret = lose tokens).
PLAID_TOKEN_FERNET_KEY=
# Optional: E.164 phone passed into Link token user (+14155552671). Omit dashes/spaces.
# PLAID_LINK_USER_PHONE=
#
# OAuth redirect (optional server default when the browser does not send redirect_uri):
# https://<frontend-host>/plaid/oauth-return — must match Plaid Dashboard → Allowed redirect URIs.
# The web app normally sends VITE_PLAID_REDIRECT_URI or origin + /plaid/oauth-return from the client.
# PLAID_REDIRECT_URI=https://financial-app-5ywr.onrender.com/plaid/oauth-return

# Credit-card minimum payments via Plaid Liabilities (optional).
# Leave disabled until Plaid has approved and enabled the Liabilities product
# for this environment (Dashboard → Products). Manual minimums still work.
PLAID_ENABLE_LIABILITIES=false
# How long an institution-reported minimum stays "fresh" before the UI warns.
# Invalid values fail Django startup with a clear configuration error.
MINIMUM_PAYMENT_FRESHNESS_DAYS=45
# Optional. When set, Plaid can POST liability updates to this HTTPS URL.
# Must be publicly reachable. Do not commit a real production webhook URL.
# PLAID_WEBHOOK_URL=https://<your-api-host>/api/plaid/webhooks/liabilities/

# Stripe billing (optional in local development). Leave empty to run the app without
# Checkout. Billing API endpoints fail with HTTP 503 until these are set.
# Never commit live keys. Price ID comes from Stripe Dashboard → Product → Price.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# Optional publishable key for future frontend work (Checkout is created by the backend).
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional origin used for Checkout success/cancel, Customer Portal return URLs,
# and authentication email links (verify email / reset password).
# Defaults to RENDER_EXTERNAL_URL in production, http://localhost:5173 when DEBUG=True.
# FRONTEND_ORIGIN=http://localhost:5173

# Email (local default is console backend — messages print to the Django log).
# Production: set a real transactional provider (SMTP or vendor backend).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=noreply@example.com
# EMAIL_VERIFICATION_MAX_AGE=172800
# PASSWORD_RESET_TIMEOUT=259200

# Web (Vite) — see apps/web/.env.example
# Local: omit VITE_API_URL (same-origin /api via Vite proxy).
# Render Static Site: VITE_API_URL=https://budget-app-api.onrender.com
# Plaid: VITE_PLAID_REDIRECT_URI=https://financial-app-5ywr.onrender.com/plaid/oauth-return

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:8000
