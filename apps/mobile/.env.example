# Mobile environment (copy to `.env` for local development)
#
# Two primary workflows — pick ONE and restart Expo after changing:
#   .env.local.example  → Local Django (fast iteration)
#   .env.render.example → Render Django (realistic performance testing)
#
# WARNING: Pointing at production Render means creates/edits/deletes are REAL.

# App environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Client financial-engine mode: server (default) | shadow | client.
# Keep production on shadow until mismatch rate is ~0. Do not default to client.
# EXPO_PUBLIC_FINANCIAL_ENGINE_MODE=shadow
# Legacy alias (maps to shadow): EXPO_PUBLIC_FINANCIAL_ENGINE_SHADOW=true

# Canonical API base URL (no trailing slash). Required — no silent fallback.
# Simulator example:
EXPO_PUBLIC_API_URL=http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Physical device:  http://<YOUR-LAN-IP>:8000
# Render testing:   https://flowsight360.com

# Defaults to https://flowsight360.com/privacy and /terms when unset.
# EXPO_PUBLIC_PRIVACY_URL=https://flowsight360.com/privacy
# EXPO_PUBLIC_TERMS_URL=https://flowsight360.com/terms
# Optional. Shown in Settings → About when set.
# EXPO_PUBLIC_SUPPORT_EMAIL=
# EXPO_PUBLIC_SENTRY_DSN=
# Numeric App Store id once assigned (leave empty until then — do not invent one).
# EXPO_PUBLIC_IOS_APP_STORE_ID=
# Optional Play Store listing override. Default is built from the Android package in app.config.ts.
# EXPO_PUBLIC_GOOGLE_PLAY_STORE_URL=
# HTTPS Plaid OAuth redirect. Must be allowlisted in the Plaid Dashboard.
# Default: https://flowsight360.com/plaid/oauth-return
# EXPO_PUBLIC_PLAID_REDIRECT_URI=https://flowsight360.com/plaid/oauth-return
# Optional. Required for Expo push tokens on native `expo run:*` / EAS builds.
# Leave unset for local Metro/emulator work; push registration is skipped.
# EAS_PROJECT_ID=
