# Mobile API base URL (no trailing slash).
#
# iOS Simulator:     http://localhost:8000
# Android Emulator:  http://10.0.2.2:8000
# Physical device:   leave as localhost — the app auto-uses your Mac's LAN IP from Expo
# Production:        https://your-api-host
#
# IMPORTANT: Django must be running and reachable from the device/simulator.
#   docker compose up backend        (from repo root; requires Docker)
#   cd backend && python manage.py runserver 0.0.0.0:8000   (native)
EXPO_PUBLIC_API_URL=http://localhost:8000
