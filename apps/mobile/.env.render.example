# Realistic production-performance testing — copy to `.env` then restart Expo:
#   cp .env.render.example .env
#
# Topology:
#   Mobile → Internet → Render Django → Render PostgreSQL / Redis
#
# This does NOT connect local Django to the production DB.
# All auth + API traffic uses the same EXPO_PUBLIC_API_URL below.
#
# ⚠ PRODUCTION DATA WARNING
# Creates, edits, deletes, transactions, recurring changes, and reconciliation
# against this host are REAL. Prefer a staging Render service for destructive tests
# if one exists. Do not treat this as a sandbox.

EXPO_PUBLIC_APP_ENV=development

# Current Render web service (API + UI). HTTPS required for hosted targets.
EXPO_PUBLIC_API_URL=https://financial-app-1-tu0l.onrender.com
