# Fast local development — copy to `.env` then restart Expo:
#   cp .env.local.example .env
#
# Topology:
#   Mobile → Local Django (:8000) → Local database
#
# Backend (separate terminal):
#   cd backend && ALLOWED_HOSTS='*' python3 manage.py runserver 0.0.0.0:8000
#
# Pick the URL that matches your client — do not rely on auto-detection:

EXPO_PUBLIC_APP_ENV=development

# iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:8000

# Android Emulator (uncomment instead of localhost):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Physical device on same Wi‑Fi (required — phone cannot use Mac localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
